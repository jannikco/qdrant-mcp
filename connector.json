{
  "id": "qdrant",
  "name": "Qdrant Cloud",
  "version": "0.1.0",
  "baseUrl": "https://{QDRANT_HOST}:6333",
  "auth": {
    "type": "header",
    "env": "QDRANT_API_KEY",
    "header": "api-key"
  },
  "description": "Inspect collections, query supplied vectors and explicitly approve point upserts on a Qdrant Cloud DNS endpoint.",
  "tools": [
    {
      "name": "list_collections",
      "description": "List collections on the configured Qdrant Cloud cluster.",
      "method": "GET",
      "path": "/collections",
      "readOnly": true,
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "bindings": {
        "path": [],
        "query": {},
        "body": {}
      },
      "sampleArguments": {},
      "provenance": [
        "https://raw.githubusercontent.com/qdrant/qdrant/master/docs/redoc/master/openapi.json"
      ]
    },
    {
      "name": "query_points",
      "description": "Read nearest points for a numeric query vector. Vector dimension must match the selected collection.",
      "method": "POST",
      "path": "/collections/{collection_name}/points/query",
      "readOnly": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "collection_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "query": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 1,
            "maxItems": 4096
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "with_payload": {
            "type": "boolean"
          }
        },
        "required": [
          "collection_name",
          "query"
        ],
        "additionalProperties": false
      },
      "bindings": {
        "path": [
          "collection_name"
        ],
        "query": {},
        "body": {
          "query": "query",
          "limit": "limit",
          "with_payload": "with_payload"
        }
      },
      "sampleArguments": {
        "collection_name": "documents",
        "query": [
          0.1,
          0.2,
          0.3
        ],
        "limit": 5,
        "with_payload": true
      },
      "provenance": [
        "https://raw.githubusercontent.com/qdrant/qdrant/master/docs/redoc/master/openapi.json"
      ]
    },
    {
      "name": "upsert_points",
      "description": "Explicitly approved point insertion/update. Existing IDs are overwritten; acknowledged is not proof an asynchronous operation completed.",
      "method": "PUT",
      "path": "/collections/{collection_name}/points",
      "readOnly": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "collection_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "points": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 36,
                      "format": "uuid"
                    }
                  ]
                },
                "vector": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 1,
                  "maxItems": 4096
                },
                "payload": {
                  "type": "object",
                  "maxProperties": 50,
                  "additionalProperties": true
                }
              },
              "required": [
                "id",
                "vector"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 100
          },
          "wait": {
            "type": "boolean"
          }
        },
        "required": [
          "collection_name",
          "points"
        ],
        "additionalProperties": false
      },
      "bindings": {
        "path": [
          "collection_name"
        ],
        "query": {
          "wait": "wait"
        },
        "body": {
          "points": "points"
        }
      },
      "sampleArguments": {
        "collection_name": "documents",
        "points": [
          {
            "id": 1,
            "vector": [
              0.1,
              0.2,
              0.3
            ],
            "payload": {
              "source": "fixture"
            }
          }
        ],
        "wait": true
      },
      "provenance": [
        "https://raw.githubusercontent.com/qdrant/qdrant/master/docs/redoc/master/openapi.json"
      ]
    }
  ],
  "provenance": [
    "https://raw.githubusercontent.com/qdrant/qdrant/master/docs/redoc/master/openapi.json"
