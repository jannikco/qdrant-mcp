{
  "openapi": "3.1.0",
  "info": {
    "title": "Qdrant Cloud selected operations",
    "version": "0.1.0",
    "description": "Reviewed local connector bindings for manual API import. No provider credentials are included; authentication and hosted execution require separate configuration and tests."
  },
  "servers": [
    {
      "url": "https://{QDRANT_HOST}:6333",
      "variables": {
        "QDRANT_HOST": {
          "default": "your-account.example.com",
          "description": "Replace with your own authorized provider account value."
        }
      }
    }
  ],
  "paths": {
    "/collections": {
      "get": {
        "operationId": "list_collections",
        "summary": "List collections on the configured Qdrant Cloud cluster.",
        "parameters": [],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      }
    },
    "/collections/{collection_name}/points/query": {
      "post": {
        "operationId": "query_points",
        "summary": "Read nearest points for a numeric query vector. Vector dimension must match the selected collection.",
        "parameters": [
          {
            "name": "collection_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 1,
                    "maxItems": 4096
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  "with_payload": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        }
      }
    },
    "/collections/{collection_name}/points": {
      "put": {
        "operationId": "upsert_points",
        "summary": "Explicitly approved point insertion/update. Existing IDs are overwritten; acknowledged is not proof an asynchronous operation completed.",
        "parameters": [
          {
            "name": "collection_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "wait",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "x-pipmcp-read-only": false,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "points": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 36,
                              "format": "uuid"
                            }
                          ]
                        },
                        "vector": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 1,
                          "maxItems": 4096
                        },
                        "payload": {
                          "type": "object",
                          "maxProperties": 50,
                          "additionalProperties": true
                        }
                      },
                      "required": [
                        "id",
                        "vector"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1,
                    "maxItems": 100
                  }
                },
                "required": [
                  "points"
                ]
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "providerAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "api-key"
      }
    }
  },
  "security": [
    {
      "providerAuth": []
    }
  ]
}
