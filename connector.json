  ],
  "allowedHostSuffixes": [
    "cloud.qdrant.io"
  ],
  "sampleEnvironment": {
    "QDRANT_HOST": "fixture-cluster.eu-west-2-0.aws.cloud.qdrant.io"
  },
  "workflow": {
    "name": "Inspect and update vector records",
    "description": "List collections, query a supplied vector, and only after reviewing point IDs approve an upsert into the same collection. Re-query to inspect provider results; dimensions and collection access remain provider-enforced.",
    "steps": [
      "list_collections",
      "query_points",
      "upsert_points"
    ]
  },
